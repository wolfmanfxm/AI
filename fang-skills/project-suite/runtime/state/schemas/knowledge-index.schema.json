{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fang-skills/project-suite/runtime/state/schemas/knowledge-index.schema.json",
  "title": "Knowledge Index",
  "description": "Capability-based knowledge lookup schema. Maps capability labels to knowledge files.",
  "type": "object",
  "required": ["schemaVersion", "generatedBy", "generatedAt", "capabilities"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version for forward compatibility"
    },
    "generatedBy": {
      "type": "string",
      "const": "knowledge-compiler",
      "description": "Producer: standalone runtime/knowledge/ module. Scans .md files in the 8 knowledge directories (rules/decisions/patterns/components/api/architecture/experience/playbooks). graph.json is the Resolver's structural input, NOT the Compiler's input."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "type": "object",
      "description": "Capability label → definition mapping",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "files"],
        "properties": {
          "description": {
            "type": "string",
            "description": "One-line summary of what this capability covers"
          },
          "files": {
            "type": "array",
            "description": "Knowledge files under .project-knowledge/, each carrying unified Knowledge Metadata.",
            "items": {
              "type": "object",
              "required": ["source", "type", "enforcement", "priority"],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Relative path under .project-knowledge/, e.g. rules/form-component-standard.md"
                },
                "type": {
                  "type": "string",
                  "enum": ["rule", "decision", "pattern", "component", "api", "experience", "playbook"],
                  "description": "Knowledge object category"
                },
                "enforcement": {
                  "type": "string",
                  "enum": ["blocking", "recommended", "advisory"],
                  "description": "blocking = MUST follow; recommended = should follow; advisory = reference only"
                },
                "priority": {
                  "type": "string",
                  "enum": ["P1", "P2", "P3"],
                  "description": "P1=rules/project-decisions, P2=patterns/architecture/components/api/task-decisions, P3=experience/playbooks"
                },
                "scope": {
                  "type": "string",
                  "enum": ["task", "project", "organization", "personal"],
                  "description": "仅 decision 使用：task=一次性 feature ADR（不进 blocking constraints），project=长期项目决策（blocking）"
                }
              }
            },
            "minItems": 1
          },
          "depends_on": {
            "type": "array",
            "description": "Prerequisite capabilities that should be loaded first",
            "items": { "type": "string" }
          }
        }
      }
    },
    "aliases": {
      "type": "object",
      "description": "Chinese shorthand → capability name mapping",
      "additionalProperties": { "type": "string" }
    }
  }
}
