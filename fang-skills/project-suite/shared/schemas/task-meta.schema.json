{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-suite/schemas/task-meta.schema.json",
  "title": "Task Meta",
  "description": "一个长期任务的身份与生命周期。位于 .project-knowledge/runtime/tasks/<task_id>/meta.json。",
  "type": "object",
  "required": ["schemaVersion", "task_id", "goal", "status", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "task_id": {
      "type": "string",
      "pattern": "^task-[0-9]{8}(-[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "task-YYYYMMDD[-slug]，跨 Claude Session 保持不变"
    },
    "goal": { "type": "string", "minLength": 1, "description": "一句话目标" },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "completed", "abandoned"]
    },
    "originating_skill": { "type": ["string", "null"] },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "已废弃：历史任务保留读取兼容；新任务不再写入。执行历史以 timeline.jsonl 为准（无消费者）。"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "任务产物相对 .project-knowledge/ 的路径"
    },
    "session_id": { "type": ["string", "null"] },
    "migrated_from": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
