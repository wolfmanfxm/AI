{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Graph",
  "description": "项目结构关系图谱。由 analyzer 的 Post Processing 从各维度汇总生成。",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "graph.schema.json 的版本"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["module", "file", "symbol", "call", "reference", "impact"]
      },
      "description": "本 graph 具备的查询能力。project-analyzer 只声明 module/file；symbol/call/reference/impact 由外部 Code Intelligence provider（如 CodeGraph）声明。仅元数据，不存储 symbol 数据。"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "group"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["layer", "component", "api", "infrastructure", "store", "view"]
          },
          "label": { "type": "string" },
          "refs": { "type": "integer", "description": "引用次数（组件）" },
          "functions": { "type": "integer", "description": "导出函数数（API）" },
          "group": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "relation": { "type": "string", "description": "关系描述：imports/使用/组合/配置/依赖" }
        }
      }
    }
  }
}
