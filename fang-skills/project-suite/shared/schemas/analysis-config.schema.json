{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis Config",
  "description": "Analyzer skill 的用户配置。首次分析时写入，此后只读。",
  "type": "object",
  "required": ["projectName", "mode", "scope"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "analysis-config.schema.json 的版本"
    },
    "projectName": {
      "type": "string",
      "description": "项目名称"
    },
    "mode": {
      "type": "string",
      "enum": ["quick", "standard", "deep", "incremental"],
      "description": "分析模式：quick/standard/deep 为深度；incremental 表示只重扫漂移领域（graph.json 仍全量重建）"
    },
    "scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "扫描范围：源码目录列表"
    },
    "output": {
      "type": "array",
      "items": { "type": "string", "enum": ["vault", "local"] },
      "description": "输出位置（可选；缺省视为 local，即 .project-knowledge/）"
    },
    "vaultPath": {
      "type": "string",
      "description": "Obsidian Vault 路径"
    },
    "firstAnalysis": {
      "type": "boolean",
      "description": "是否首次分析"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "skillVersion": {
      "type": "string",
      "description": "analyzer skill 版本"
    }
  }
}
