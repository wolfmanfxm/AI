{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflow.schema.json",
  "title": "Workflow DSL Schema",
  "description": "声明式 Workflow 定义。Engine 读取并驱动执行。替代 prose-based execution-driver。",
  "type": "object",
  "required": ["version", "skill", "stages"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "skill": { "type": "string", "description": "skill id, e.g. project-analyzer" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "template"],
        "properties": {
          "name": { "type": "string", "description": "discovery | execution | validation | delivery | code-audit | graph-analysis" },
          "template": { "type": "string", "description": "stage-templates/<name>.md — Engine 加载的模板" },
          "prompt": { "type": "string", "description": "prompts/<name>.md — 业务逻辑" },
          "entry": { "type": "array", "items": { "type": "string" }, "description": "Entry conditions (Engine checked)" },
          "exit": { "type": "array", "items": { "type": "string" }, "description": "Exit conditions (Engine verified)" },
          "parallel": { "type": "boolean", "default": false, "description": "子任务可并行执行" },
          "retry": { "type": "integer", "default": 0, "description": "Exit 不满足时最大重试次数" },
          "checkpoint": { "type": "boolean", "default": false, "description": "是否需要 CHECKPOINT" },
          "blocking": { "type": "boolean", "default": false, "description": "Exit 不满足是否阻断 pipeline" },
          "on_failure": { "type": "string", "enum": ["retry", "skip", "block", "ask"], "default": "block", "description": "失败时的默认行为" },
          "auto_advance": { "type": "boolean", "default": false, "description": "Exit 满足是否自动进入下一 stage" }
        }
      }
    }
  }
}
