{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowledge-object.schema.json",
  "title": "Knowledge Object v2.0",
  "description": "统一知识对象。.md 仅为 View，此为 Runtime 权威数据模型。",

  "type": "object",
  "required": ["id", "type", "scope", "confidence"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["pattern", "convention", "principle", "decision", "risk", "antipattern", "component", "api", "module", "glossary", "framework", "instinct", "playbook"]
    },
    "scope": {
      "type": "string",
      "enum": ["task", "project", "organization", "personal"],
      "description": "四层 scope: task=一次性, project=项目级, organization=企业级, personal=个人资产"
    },
    "promotion": {
      "type": "string",
      "enum": ["none", "project", "organization", "personal"],
      "default": "project"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },

    "statement": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "occurrences": { "type": "integer" },

    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "relation": { "type": "string", "enum": ["depends_on", "implements", "contradicts", "composes", "references", "example_of", "promoted_from"] }
        }
      }
    },

    "decay": {
      "type": "object",
      "properties": {
        "last_verified": { "type": "string", "format": "date-time" },
        "last_used": { "type": "string", "format": "date-time" },
        "stability": { "type": "number", "minimum": 0, "maximum": 1, "description": "1.0=稳定, <0.3=触发decay" },
        "deprecated": { "type": "boolean", "default": false },
        "decay_reason": { "type": "string" }
      }
    },

    "score": {
      "type": "object",
      "properties": {
        "quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "reuse": { "type": "integer", "description": "被下游 Skill 消费的次数" },
        "freshness": { "type": "number", "minimum": 0, "maximum": 1, "description": "1.0=今天验证, 0=从未验证" }
      }
    },

    "review": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "expired"] },
        "reviewed_by": { "type": "string" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "queue_position": { "type": "integer" }
      }
    },

    "owner": { "type": "string", "description": "创建者或 promoter" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
